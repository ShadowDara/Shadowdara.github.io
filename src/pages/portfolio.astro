---
import "../styles/portfolio.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Shadowdara — Computer Science</title>
    <meta
      name="description"
      content="Computer Science student focused on compilers, programming languages and systems programming."
    />
  </head>

  <body>
    <header>
      <div class="container">
        <nav>
          <a class="logo" href="/">shadowdara</a>

          <div class="nav-links">
            <a href="#projects">Projects</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <!-- INTRO -->

      <div class="container">
        <section class="hero" style="border-top: 0">
          <div class="eyebrow">Computer Science · Programming Languages</div>

          <h1>Building software close to the machine.</h1>

          <p class="intro">
            Computer Science student interested in compilers, programming
            languages, runtimes and systems programming.
          </p>

          <div class="links">
            <a href="https://github.com/shadowdara">GitHub ↗</a>
            <a href="mailto:shadowdara74@gmail.com">Email ↗</a>
          </div>
        </section>
      </div>

      <!-- ABOUT -->

      <section id="about">
        <div class="container">
          <h2 class="section-title">About</h2>

          <div class="about">
            <p>
              I'm currently studying Computer Science and enjoy understanding
              how software works below the application layer.
            </p>

            <p>
              My main interests are programming languages, compilers,
              interpreters, native applications and developer tooling.
            </p>

            <p>
              I like building things myself and learning through implementation
              rather than only studying the theory.
            </p>
          </div>
        </div>
      </section>

      <!-- PROJECTS -->

      <section id="projects">
        <div class="container">
          <h2 class="section-title">Selected projects</h2>

          <div class="projects">
            <a class="project" href="#">
              <div class="project-header">
                <span class="project-name">fing</span>
                <span class="project-type">Interpreter</span>
              </div>

              <p>
                A small programming language with a hand-written lexer, parser,
                AST and interpreter.
                <!-- Currently being extended towards
              native code generation. -->
              </p>

              <div class="tags">
                <span class="tag">C++</span>
                <span class="tag">Compiler</span>
                <span class="tag">AST</span>
                <span class="tag">Parsing</span>
              </div>
            </a>

            <a class="project" href="#">
              <div class="project-header">
                <span class="project-name">samfileparser</span>
                <span class="project-type">Developer Tool</span>
              </div>

              <p>
                A lightweight Makefile-like parser and task runner designed
                around a simple human-readable syntax.
              </p>

              <div class="tags">
                <span class="tag">Rust</span>
                <span class="tag">Parser</span>
                <span class="tag">CLI</span>
              </div>
            </a>

            <!-- <a class="project" href="#">
            <div class="project-header">
              <span class="project-name">samengine</span>
              <span class="project-type">Engine</span>
            </div>

            <p>
              A small experimental game engine and tooling ecosystem,
              focused on keeping the development stack lightweight.
            </p>

            <div class="tags">
              <span class="tag">TypeScript</span>
              <span class="tag">C++</span>
              <span class="tag">SDL</span>
              <span class="tag">Systems</span>
            </div>
          </a> -->

            <!--
            Add more projects by copying a .project block.
          -->
          </div>
        </div>
      </section>

      <!-- SKILLS -->

      <section>
        <div class="container">
          <h2 class="section-title">Technical interests</h2>

          <div class="skills">
            <div class="skill">
              <div class="skill-name">Languages</div>
              <div class="skill-list">Rust · C++ · TypeScript · C · Python</div>
            </div>

            <div class="skill">
              <div class="skill-name">Compilers</div>
              <div class="skill-list">
                Lexing · Parsing · ASTs · IR · LLVM · JIT
              </div>
            </div>

            <div class="skill">
              <div class="skill-name">Systems</div>
              <div class="skill-list">
                Linux · Windows · Processes · Networking · C ABI
              </div>
            </div>

            <div class="skill">
              <div class="skill-name">Tooling</div>
              <div class="skill-list">
                Git · Cargo · npm · CMake · CLI development
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- EXPERIENCE / EDUCATION -->

      <section>
        <div class="container">
          <h2 class="section-title">Education</h2>

          <div class="timeline">
            <div class="timeline-item">
              <div class="timeline-date">2026 — present</div>

              <div>
                <div class="timeline-title">B.Sc. Computer Science</div>

                <div class="timeline-description">
                  University Name is private for now, will be published soon!
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CONTACT -->

      <section id="contact">
        <div class="container">
          <h2 class="section-title">Contact</h2>

          <div class="about">
            <p>
              If you're interested in my work or want to talk about compilers,
              programming languages or systems programming, feel free to get in
              touch.
            </p>

            <div class="links">
              <a href="mailto:shadowdara74@gmail.com">shadowdara74@gmail.com</a>
              <a href="https://github.com/shadowdara">GitHub ↗</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container">© 2026 Shadowdara</div>
    </footer>
  </body>
</html>
