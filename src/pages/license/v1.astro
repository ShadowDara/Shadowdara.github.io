---

import "../../styles/global.css"

// src/pages/license.astro
const licenseText = `
Fair Use & Truthfulness License

Permission is hereby granted, free of charge, to any person obtaining a copy of this work and associated materials (the “Work”), to use, copy, modify, distribute, publish, and share the Work for any purpose, including commercial purposes, without attribution or credit requirements.

The only condition is the following:

You may not knowingly misrepresent, falsify, or lie about how the Work functions, operates, or was created.


Any claims, explanations, demonstrations, or documentation regarding the Work must be made in good faith and reflect its actual behavior and capabilities to the best of your knowledge.

Failure to comply with this condition voids the permission granted by this license.

THE WORK IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, AND NON-INFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES, OR OTHER LIABILITY ARISING FROM THE WORK OR THE USE OF THE WORK.

More Infos at https://shadowdara.github.io/license/v1
`;

---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>License</title>
  </head>  <body class="bg-zinc-950 text-zinc-100 antialiased">
    <main class="mx-auto flex min-h-screen max-w-3xl items-center px-6 py-20">
      <section class="w-full rounded-2xl border border-white/10 bg-zinc-900/70 p-8 shadow-xl">
        <div class="mb-6 flex items-center justify-between gap-4">
          <div>
            <p class="text-sm uppercase tracking-[0.2em] text-zinc-500">
              License
            </p>
            <h1 class="mt-1 text-3xl font-bold">MIT License</h1>
          </div><button
        id="copyButton"
        class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm transition hover:bg-white/10"
      >
        Copy
      </button>
    </div>

    <div class="overflow-hidden rounded-xl border border-white/10 bg-black/30">
      <pre
        id="licenseText"
        class="overflow-x-auto p-6 text-sm leading-7 text-zinc-300"
      ><code>{licenseText}</code></pre>
    </div>
  </section>
</main>

<script>
  const button = document.getElementById('copyButton')
  const text = document.getElementById('licenseText')?.innerText

  button?.addEventListener('click', async () => {
    if (!text) return

    await navigator.clipboard.writeText(text)

    button.innerText = 'Copied!'

    setTimeout(() => {
      button.innerText = 'Copy'
    }, 2000)
  })
</script>

  </body>
</html>
