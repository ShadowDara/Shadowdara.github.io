---
import Layout from "../layouts/Layout.astro";
import { p, b } from "../consts";
import "./../styles/pages.css";

import { getProjects } from "../lib/projects";

const projects = getProjects()
  .sort((a, b) =>
    new Date(b.lastUpdated ?? Date.now()) -
    new Date(a.lastUpdated ?? Date.now())
  );
---

<Layout title={p.SITE_TITLE} description={p.SITE_DESCRIPTION}>
  <main class="justify-center">
    <div class="d4r-box">
      <h1 class="text-center">Recent Projects</h1>

      <div>
        <h3 class="text-center">
          <a href=`${b}/`>Home</a>
          ·
          <a href=`${b}/blog/`>Blog</a>
        </h3>
      </div>

      <div class="projects-grid">
        {
          projects.map((p) => (
            <div class="project">
              <h2 class="text-center">
                <a href={p.url} target="_blank">
                  {p.title}
                </a>
              </h2>
              <p class="text-center">{p.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </main>
</Layout>

<style>
  main {
    margin-top: 4%;
    margin-bottom: 4%;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;

    max-width: 900px;
    width: 100%;
    margin: 2rem auto 0 auto;
  }

  .project:hover {
    transform: translateY(-6px);
    border: 1px solid rgba(255, 0, 195, 0.5);

    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.4),
      0 0 25px rgba(255, 0, 195, 0.25);
  }

  .project {
    background: rgba(20, 0, 25, 0.7);
    border: 1px solid rgba(255, 0, 195, 0.15);
    border-radius: 18px;

    padding: 1.2rem 1.3rem;
    position: relative;

    backdrop-filter: blur(10px);

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border 0.2s ease;
  }

  /* .project h2 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
    color: #ff4fd8;
}

.project p {
    font-size: 0.95rem;
    opacity: 0.8;
    line-height: 1.4;
} */

  .project a {
    text-decoration: none;
    color: inherit;
  }

  .project a:hover {
    text-decoration: underline;
  }

  .project::before {
    content: "";
    position: absolute;
    top: 0;
    left: 10%;
    width: 80%;
    height: 2px;
    background: linear-gradient(90deg, transparent, #ff00c3, transparent);
    opacity: 0.6;
  }

  @media (max-width: 1000px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 650px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
