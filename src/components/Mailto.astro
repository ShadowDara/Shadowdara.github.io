---
const {
  email,
  subject = "",
  body = "",
  cc = "",
  bcc = "",
  class: className = "",
  label = "E-Mail senden"
} = Astro.props;

const encode = (v) => encodeURIComponent(v);

const params = [];

if (subject) params.push(`subject=${encode(subject)}`);
if (body) params.push(`body=${encode(body)}`);
if (cc) params.push(`cc=${encode(cc)}`);
if (bcc) params.push(`bcc=${encode(bcc)}`);

const mailto = `mailto:${email}${params.length ? "?" + params.join("&") : ""}`;
---

<a href={mailto} class={className}>
  {label}
</a>
