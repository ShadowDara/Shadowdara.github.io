---
import { b } from "../../consts";
---

<div class="settings_btn d4r-box">
    <h1 class="text-center">Pages</h1>

    <a href=`https://zug-fahren.vercel.app` target="_blank">
        <div class="settings-box text-center">
            <p>Zug fahren</p>
        </div>
    </a>

    <a href=`${b}/mctools` target="_blank">
        <div class="settings-box text-center">
            <p>Minecraft Tools</p>
        </div>
    </a>

    <a href=`https://samengine.vercel.app` target="_blank">
        <div class="settings-box text-center">
            <p>samengine</p>
        </div>
    </a>

    <a href=`/blog`>
        <div class="settings-box text-center">
            <p>Posts</p>
        </div>
    </a>
</div>

<style>
    
    .settings-box {
        color: var(--box-bg-color);
        background-color: var(--settings-inner-box-component);
        font-family: "Fira Code", monospace;
        color: var(--settings-inner);
        padding: 0.5rem;
        margin: 0.7rem 0rem;
        border-radius: 20px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        width: 100%;
        word-break: break-all;
        display: flex;
        flex-direction: column;
        transition:
            transform 1s ease,
            background-color 1s ease;
    }

    .settings-box:hover {
        background-color: var(--settings-inner-box-component-h);
        box-shadow:
            0 0 10px rgb(255, 0, 195),
            0 0 25px rgb(255, 0, 195),
            0 0 50px rgb(255, 0, 195);
    }

    .settings-box p {
        font-size: 1.3rem;
        font-weight: bold;
    }
    

    .settings_btn {
        font-family: monospace;
        background-color: rgb(0, 0, 0);
        color: var(--h3-color);
        padding: 0.6rem;
        border-radius: 20px;
        margin: 0.6rem;
        font-size: 1.4rem;
        transition:
            transform 2s ease,
            background-color 2s ease;
        display: flex;
        flex-direction: column;
        width: 95%;
        word-break: break-all;
    }

    .settings_btn:hover {
        /* background-color: var(--settings-hover); */
        color: black;
        font-weight: bold;
        box-shadow:
            0 0 10px rgb(255, 0, 195),
            0 0 25px rgb(255, 0, 195),
            0 0 50px rgb(255, 0, 195);
    }

    .settings_btn a {
        margin-left: 10px;
        margin-right: 10px;
    }
</style>
