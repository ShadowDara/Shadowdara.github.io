---
import "/src/styles/global.css";
import "/src/styles/links.css";

import { getProjects } from "../../lib/projects.ts";

const projects = getProjects()
    .filter((p) => p.showcase)
    .sort(
        (a, b) =>
            new Date(b.lastUpdated ?? Date.now()) -
            new Date(a.lastUpdated ?? Date.now()),
    );
---

<!-- The Projects which will be dsiplayed on the Startpage --><!-- List of my Recent Projects -->{
    projects.map((p) => (
        <div class="project">
            <h2 class="text-center"><a href={p.url} target="_blank">{p.title}</a></h2>

            <p>{p.description}</p>
        </div>
    ))
}

<style>
    /* For Projects and Downloads inside the main page! */
    .project {
        background-color: var(--project-box-color);
        border-radius: 30px;
        padding: 0.8rem 1.1rem;
        margin: 0.6rem;
    }

    .project h2 {
        color: var(--project-h2-color);
        font-weight: bold;
    }

    .project p {
        color: var(--project-p-color);
        font-weight: bold;
    }

    .project a {
        text-decoration: underline;
        font-weight: bold;
    }
</style>
